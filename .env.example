# Optional: Set these if you want to switch to Gemini or Qdrant Cloud Free Tier

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Qdrant Cloud (Free forever 1GB cluster at https://cloud.qdrant.io/)
# If left blank, MyRag automatically stores vectors locally on disk for 100% free offline usage.
QDRANT_URL=
QDRANT_API_KEY=

# Ollama Host (Optional, if using local Ollama)
OLLAMA_HOST=http://localhost:11434
